        "runed": "^0.37.1",
        "svelte": "^5.57.0",
        "svelte-check": "^4.7.6",
        "svelte-confetti": "^2.3.2",
        "svelte-sonner": "^1.2.1",
        "svelte-tel-input": "^3.6.1",
        "svelte-toolbelt": "^0.10.6",
        "sveltekit-sse": "^0.15.1",
        "sveltekit-superforms": "^2.30.2",
        "tailwind-merge": "^3.6.0",
