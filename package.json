{
    "name": "riven-frontend",
    "private": true,
    "version": "1.20.0",
    "type": "module",
    "packageManager": "pnpm@10.28.0",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || true",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier --write .",
        "format:changelog": "prettier --write CHANGELOG.md",
        "lint": "prettier --check . && eslint .",
        "lint:changelog": "prettier --check CHANGELOG.md",
        "lint-staged": "lint-staged",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:legacy": "tsx ./scripts/run_tests.ts",
        "ba:generate": "pnpx @better-auth/cli generate --config ./better-auth.config.ts --output ./src/lib/server/schema/ba-auth.ts --yes",
        "db:generate": "drizzle-kit generate",
        "db:pull": "tsx ./scripts/drizzle_pull.ts",
        "db:studio": "drizzle-kit studio",
        "generate-api": "tsx ./scripts/generate_riven_api.ts"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^9.39.2",
        "@fontsource/jetbrains-mono": "^5.3.0",
